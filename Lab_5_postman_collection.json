  "item": [
    {
      "name": "GET: немає в кеші",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Статус 200\", () => pm.response.to.have.status(200));\r",
              "pm.test(\"Content-Type: image/jpeg\", () =>\r",
              "  pm.response.to.have.header(\"Content-Type\", \"image/jpeg\"));\r",
              "pm.test(\"Джерело: http.cat\", () =>\r",
              "  pm.response.to.have.header(\"X-Image-Source\", \"http.cat\"));\r",
              "\r",
              "pm.collectionVariables.set(\"catLength\", pm.response.headers.get(\"Content-Length\"));\r",
              "pm.collectionVariables.set(\"missTime\", pm.response.responseTime);"
            ],
            "type": "text/javascript",
            "packages": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/{{code}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "{{code}}"
          ]
        }
      },
      "response": []
    },
